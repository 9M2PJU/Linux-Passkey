{
  "manifest_version": 3,
  "name": "Linux Passkey",
  "version": "0.1.0",
  "description": "Use passkeys stored on this computer, confirmed with your Linux password or fingerprint.",
  "homepage_url": "https://github.com/HaythmKenway/Linux-Passkey",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://*.localhost/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://*.localhost/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "128": "icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "linux-passkey@haythmkenway.github.io",
      "strict_min_version": "128.0"
    }
  }
}
